{
  "inputs": [
    { "id": "azure-tenant-id", "type": "promptString", "description": "Azure tenant ID" },
    { "id": "azure-client-id", "type": "promptString", "description": "Azure client ID (service principal ADX, lecture seule)" },
    { "id": "azure-client-secret", "type": "promptString", "description": "Azure client secret", "password": true }
  ],
  "servers": {
    "adx": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "--rm", "-i",
        "-e", "ADX_CLUSTER_URL", "-e", "ADX_DATABASE",
        "-e", "AZURE_TENANT_ID", "-e", "AZURE_CLIENT_ID", "-e", "AZURE_CLIENT_SECRET",
        "adx-mcp-server"],
      "env": {
        "ADX_CLUSTER_URL": "https://adxoptirevenue.northeurope.kusto.windows.net",
        "ADX_DATABASE": "onconnect",
        "AZURE_TENANT_ID": "${input:azure-tenant-id}",
        "AZURE_CLIENT_ID": "${input:azure-client-id}",
        "AZURE_CLIENT_SECRET": "${input:azure-client-secret}"
      }
    },
    "azure-devops": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "suezsmartsolutions"]
    }
  }
}
